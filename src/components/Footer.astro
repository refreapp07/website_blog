---
import { t } from '../i18n/i18n.js';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<footer id="footer">
  <div class="inner">
    <ul class="icons">
      <li>
        <a href="https://x.com/Kajoble07" class="icon brands alt fa-twitter">
          <span class="label">Twitter</span>
        </a>
      </li>
      <li>
        <a href="https://www.facebook.com/RefreGc?ref=hl" class="icon brands alt fa-facebook-f">
          <span class="label">Facebook</span>
        </a>
      </li>
      <li>
        <a href="https://www.instagram.com/kajoble07/" class="icon brands alt fa-instagram">
          <span class="label">Instagram</span>
        </a>
      </li>
      <li>
        <a href="https://github.com/refre" class="icon brands alt fa-github">
          <span class="label">GitHub</span>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/johnnykamnang07" class="icon brands alt fa-linkedin-in">
          <span class="label">LinkedIn</span>
        </a>
      </li>
    </ul>
    <ul class="copyright">
      <li set:html={t('footer.copyright', lang)}></li>
      <li>{t('footer.design', lang)} <a href="https://html5up.net">HTML5 UP</a></li>
    </ul>
  </div>
</footer>
