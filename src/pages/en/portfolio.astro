---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/i18n.js';

const lang = 'en';
---

<BaseLayout
  lang={lang}
  title={t('portfolio.meta.title', lang)}
  description={t('portfolio.meta.description', lang)}
  ogUrl="https://kajoble.com/en/portfolio"
>
  <section id="banner" class="style2">
    <div class="inner">
      <header class="major">
        <h1>{t('portfolio.banner.title', lang)}</h1>
      </header>
      <div class="content">
        <p set:html={t('portfolio.banner.subtitle', lang)}></p>
      </div>
    </div>
  </section>

  <div id="main">

    <!-- Mobile Portfolio -->
    <section id="mobile-portfolio">
      <div class="inner">
        <header class="major">
          <h2>{t('portfolio.mobile.title', lang)}</h2>
        </header>
        <p>{t('portfolio.mobile.subtitle', lang)}</p>

        <div class="box alt">
          <div class="row gtr-50 gtr-uniform">
            <div class="col-4 col-12-small">
              <a href="/myappsitenew/mbvariet.html" class="portfolio-link">
                <span class="image fit">
                  <img src="/images/thumbs/mbossfr.png" alt="MB Variété FR" />
                </span>
                <div class="portfolio-overlay">
                  <h3>MB Variété FR</h3>
                  <p>French variety music app</p>
                </div>
              </a>
            </div>
            <div class="col-4 col-12-small">
              <a href="/myappsitenew/mbafro.html" class="portfolio-link">
                <span class="image fit">
                  <img src="/images/thumbs/mbossafro.jpg" alt="MB Afro" />
                </span>
                <div class="portfolio-overlay">
                  <h3>MB Afro</h3>
                  <p>African music streaming app</p>
                </div>
              </a>
            </div>
            <div class="col-4 col-12-small">
              <a href="/myappsitenew/mbpop.html" class="portfolio-link">
                <span class="image fit">
                  <img src="/images/thumbs/mbosspop.png" alt="MB Pop" />
                </span>
                <div class="portfolio-overlay">
                  <h3>MB Pop</h3>
                  <p>Pop music entertainment app</p>
                </div>
              </a>
            </div>
            <div class="col-4 col-12-small">
              <a href="/myappsitenew/mbrapfr.html" class="portfolio-link">
                <span class="image fit">
                  <img src="/images/thumbs/mbossrapfr.jpg" alt="MB Rap FR" />
                </span>
                <div class="portfolio-overlay">
                  <h3>MB Rap FR</h3>
                  <p>French rap platform</p>
                </div>
              </a>
            </div>
            <div class="col-4 col-12-small">
              <a href="/myappsitenew/plmjj.html" class="portfolio-link">
                <span class="image fit">
                  <img src="/images/thumbs/mjj.png" alt="Michael Jackson" />
                </span>
                <div class="portfolio-overlay">
                  <h3>MJ App</h3>
                  <p>Michael Jackson tribute app</p>
                </div>
              </a>
            </div>
            <div class="col-4 col-12-small">
              <a href="/myappsitenew/plbooba.html" class="portfolio-link">
                <span class="image fit">
                  <img src="/images/thumbs/booba.png" alt="Booba" />
                </span>
                <div class="portfolio-overlay">
                  <h3>Booba Officiel</h3>
                  <p>Official artist application</p>
                </div>
              </a>
            </div>
            <div class="col-4 col-12-small">
              <a href="/myappsitenew/mbrapus.html" class="portfolio-link">
                <span class="image fit">
                  <img src="/images/thumbs/mbossrapus.jpg" alt="MB Rap US" />
                </span>
                <div class="portfolio-overlay">
                  <h3>MB Rap US</h3>
                  <p>American hip-hop streaming app</p>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Web Portfolio -->
    <section id="web-portfolio" class="spotlights">
      <div class="inner">
        <header class="major">
          <h2>{t('portfolio.web.title', lang)}</h2>
        </header>
        <p>{t('portfolio.web.subtitle', lang)}</p>
      </div>

      <section>
        <a href="http://www.refre.be/mysites/schwarzline" class="image">
          <img src="/images/thumbs/01-sch.jpg" alt="Schwarzline" />
        </a>
        <div class="content">
          <div class="inner">
            <header class="major"><h3>Schwarzline.com</h3></header>
            <p>A complete e-commerce solution for a tire shop, with online inventory management, appointment booking, and customer service integration.</p>
            <ul class="actions">
              <li><a href="http://www.refre.be/mysites/schwarzline" class="button" target="_blank">{t('common.viewProject', lang)}</a></li>
            </ul>
          </div>
        </div>
      </section>

      <section>
        <a href="http://www.refre.be/mysites/deadalus/" class="image">
          <img src="/images/thumbs/02-daedalus.jpg" alt="Daedalus Engineering" />
        </a>
        <div class="content">
          <div class="inner">
            <header class="major"><h3>Daedalus Engineering</h3></header>
            <p>Professional website for independent engineering services in radiochemistry, medical, pharma, and food industries. Service showcase and client portal.</p>
            <ul class="actions">
              <li><a href="http://www.refre.be/mysites/deadalus/" class="button" target="_blank">{t('common.viewProject', lang)}</a></li>
            </ul>
          </div>
        </div>
      </section>

      <section>
        <a href="http://www.refre.be/mysites/tshouly/" class="image">
          <img src="/images/thumbs/03-tshouly.jpg" alt="Tshouly Concept" />
        </a>
        <div class="content">
          <div class="inner">
            <header class="major"><h3>Tshouly Concept</h3></header>
            <p>Coaching platform for personal and business development, with booking systems, resource libraries, and client management tools.</p>
            <ul class="actions">
              <li><a href="http://www.refre.be/mysites/tshouly/" class="button" target="_blank">{t('common.viewProject', lang)}</a></li>
            </ul>
          </div>
        </div>
      </section>

      <section>
        <a href="http://www.refre.be/mysites/sd/" class="image">
          <img src="/images/thumbs/04-sd.jpg" alt="S&D Tech" />
        </a>
        <div class="content">
          <div class="inner">
            <header class="major"><h3>S&D Tech</h3></header>
            <p>Corporate website for a precision machining company, showcasing capabilities, equipment portfolio, and project galleries.</p>
            <ul class="actions">
              <li><a href="http://www.refre.be/mysites/sd/" class="button" target="_blank">{t('common.viewProject', lang)}</a></li>
            </ul>
          </div>
        </div>
      </section>

      <section>
        <a href="http://www.refre.be/mysites/cloudpix/" class="image">
          <img src="/images/thumbs/05-could.jpg" alt="Cloudpix" />
        </a>
        <div class="content">
          <div class="inner">
            <header class="major"><h3>Cloudpix.be</h3></header>
            <p>Professional drone photography service website with integrated gallery, booking system, and portfolio showcase for aerial photography.</p>
            <ul class="actions">
              <li><a href="http://www.refre.be/mysites/cloudpix/" class="button" target="_blank">{t('common.viewProject', lang)}</a></li>
            </ul>
          </div>
        </div>
      </section>

      <section>
        <a href="http://www.refre.be/mysites/jl/" class="image">
          <img src="/images/thumbs/06-jl.jpg" alt="Carrefour Express" />
        </a>
        <div class="content">
          <div class="inner">
            <header class="major"><h3>Carrefour Express Liège</h3></header>
            <p>Local grocery store website with product catalogs, special offers, store information, and delivery service integration.</p>
            <ul class="actions">
              <li><a href="http://www.refre.be/mysites/jl/" class="button" target="_blank">{t('common.viewProject', lang)}</a></li>
            </ul>
          </div>
        </div>
      </section>

    </section>

    <!-- CTA -->
    <section id="cta">
      <div class="inner">
        <header class="major">
          <h2>{t('portfolio.cta.title', lang)}</h2>
        </header>
        <p>{t('portfolio.cta.text', lang)}</p>
        <ul class="actions">
          <li><a href="/en/#contact" class="button next">{t('portfolio.cta.button', lang)}</a></li>
        </ul>
      </div>
    </section>

  </div>
</BaseLayout>
