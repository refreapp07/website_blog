---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/i18n.js';

const lang = 'en';
---

<BaseLayout
  lang={lang}
  title={t('inasti.meta.title', lang)}
  description={t('inasti.meta.description', lang)}
  ogUrl="https://kajoble.com/en/inasti"
>
  <div id="main" class="alt">
    <section id="one">
      <div class="inner">
        <header class="major">
          <h1>{t('inasti.title', lang)}</h1>
        </header>
        <span class="image main"><img src="/images/inasti-banner.png" alt="" /></span>
        <p>Sequia, a large government software platform dedicated to managing the careers of self-employed workers, legal statuses, and certification processes.</p>
        <p>In this role I:</p>
        <ul>
          <li>Led the software team in improving and modernizing a mission-critical application used by public institutions and end users.</li>
          <li>Mentored junior developers, helping them strengthen their C# expertise and become autonomous, effective contributors.</li>
          <li>Defined and managed the testing strategy, improving software reliability and long-term maintainability.</li>
          <li>Designed and implemented a new publish-subscribe messaging architecture to improve scalability, decoupling, and system robustness.</li>
          <li>Contributed to full-stack development, balancing leadership responsibilities with technical delivery.</li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
